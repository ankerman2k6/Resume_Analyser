# Shared project configuration. Copy to .env and fill in secrets.
# Local .env files and OS environment variables can override shared settings.

# Backend (required): use a randomly generated secret of at least 32 bytes.
JWT_SECRET=
SPRING_MONGODB_URI=mongodb://localhost:27017/cv_screening

# Gemini (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/
GEMINI_TIMEOUT=90s

# Docker Compose
VERSION=latest
BACKEND_IMAGE=antony1552006/resume-backend
FRONTEND_IMAGE=antony1552006/resume-frontend
# Leave blank to use each Compose file's default MongoDB image.
MONGO_IMAGE=
WEB_BIND_HOST=127.0.0.1
WEB_PORT=3000

# Public mobile settings only. For a physical phone, use your PC's LAN IP.
# Leave blank to keep platform defaults or use mobile/.env.
EXPO_PUBLIC_API_BASE_URL=

# Grafana: required for monitoring Compose; set a unique strong password.
# Used to initialize admin on first startup with a fresh grafana-data volume.
GRAFANA_ADMIN_PASSWORD=
