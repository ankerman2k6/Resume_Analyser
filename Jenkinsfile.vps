def version = "v0.${BUILD_NUMBER}"

pipeline {
    agent any

    tools {
        jdk 'jdk21'
        maven 'maven3'
        nodejs 'node20'
    }

    environment {
        DOCKERHUB_USERNAME = "antony1552006"
        FRONTEND_IMAGE = "${DOCKERHUB_USERNAME}/resume-frontend"
        BACKEND_IMAGE = "${DOCKERHUB_USERNAME}/resume-backend"
        MONGO_IMAGE = "mongo:7"
        VERSION = "${version}"
        GIT_REPO_URL = "https://github.com/ankerman2k6/Resume_Analyser.git"
        GIT_BRANCH = "mobile-full-features"
        DEPLOY_HOST = "remote.io.vn"
        DEPLOY_PORT = "13852"
        DEPLOY_USER = "deploy"
        DEPLOY_DIR = "/opt/resume-analyser"
        WEB_BIND_HOST = "127.0.0.1"
        WEB_PORT = "3000"
    }

    stages {
        stage("1. Check Code") {
            steps {
                echo "=== BƯỚC 1: KÉO CODE TỪ GITHUB ==="
                git branch: "${GIT_BRANCH}", url: "${GIT_REPO_URL}"
                script {
                    // Lấy mã hash commit rút gọn (vd: a1b2c3d)
                    env.GIT_COMMIT_SHORT = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    env.VERSION_COMMIT = "${env.VERSION}-${env.GIT_COMMIT_SHORT}"
                    echo "Phiên bản build: ${env.VERSION_COMMIT}"
                }
            }
        }

        stage("2. Test Code") {
            parallel {
                stage("Test Frontend") {
                    steps {
                        echo "=== KIỂM THỬ FRONTEND ==="
                        dir('frontend') {
                            sh 'npm install'
                            sh 'npm test -- --passWithNoTests'
                        }
                    }
                }
                stage("Test Backend") {
                    steps {
                        echo "=== KIỂM THỬ BACKEND ==="
                        dir('backend') {
                            // Chạy compile và test bằng Maven để sinh class file cho SonarQube
                            sh 'chmod +x ./mvnw'
                            sh './mvnw test'
                        }
                    }
                }
            }
        }

        stage("3. SonarQube Analysis") {
            steps {
                echo "=== BƯỚC 3: QUÉT MÃ NGUỒN BẰNG SONARQUBE ==="
                script {
                    def scannerHome = tool 'sonar-scanner'
                    withSonarQubeEnv('SonarQube') {
                        // Quét mã nguồn dựa trên cấu hình trong file sonar-project.properties
                        sh "${scannerHome}/bin/sonar-scanner -Dsonar.projectVersion=${env.VERSION_COMMIT}"
                    }
                }
            }
        }

        stage("4. Quality Gate") {
            steps {
                echo "=== BƯỚC 4: KIỂM TRA CHẤT LƯỢNG MÃ NGUỒN (QUALITY GATE) ==="
                timeout(time: 2, unit: 'MINUTES') {
                    // Chờ Webhook từ SonarQube gửi tín hiệu về: Nếu code đạt chuẩn mới cho đi tiếp
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage("5. Build & Push Docker Images") {
            steps {
                echo "=== BƯỚC 5: ĐÓNG GÓI VÀ ĐẨY IMAGES LÊN DOCKER HUB ==="
                script {
                    // Sử dụng đúng credential dockerhub-credentials của bạn
                    withDockerRegistry(credentialsId: 'dockerhub-credentials', toolName: 'docker') {
                        // 1. Build & Push Frontend Image
                        echo "Đang build & push Frontend Image..."
                        dir('frontend') {
                            sh "docker buildx build --platform linux/amd64 --push -t ${FRONTEND_IMAGE}:${VERSION} -t ${FRONTEND_IMAGE}:${VERSION_COMMIT} ."
                        }

                        // 2. Build & Push Backend Image
                        echo "Đang build & push Backend Image..."
                        dir('backend') {
                            sh "docker buildx build --platform linux/amd64 --push -t ${BACKEND_IMAGE}:${VERSION} -t ${BACKEND_IMAGE}:${VERSION_COMMIT} ."
                        }

                        // Chặn deploy nếu Docker Hub chưa có image cho VPS x86_64.
                        sh "docker buildx imagetools inspect ${FRONTEND_IMAGE}:${VERSION_COMMIT} | grep -Eq 'Platform:[[:space:]]+linux/amd64'"
                        sh "docker buildx imagetools inspect ${BACKEND_IMAGE}:${VERSION_COMMIT} | grep -Eq 'Platform:[[:space:]]+linux/amd64'"

                    }
                }
            }
        }

        stage("6. Deploy to VPS via SSH") {
            steps {
                echo "=== BƯỚC 6: TRIỂN KHAI LÊN VPS QUA SSH ==="
                sh '''
                    set -eu
                    printf 'FRONTEND_IMAGE=%s\nBACKEND_IMAGE=%s\nMONGO_IMAGE=%s\nVERSION=%s\nWEB_BIND_HOST=%s\nWEB_PORT=%s\n' \
                        "$FRONTEND_IMAGE" "$BACKEND_IMAGE" "$MONGO_IMAGE" "$VERSION_COMMIT" \
                        "$WEB_BIND_HOST" "$WEB_PORT" > .env.vps
                '''
                sshagent(credentials: ['vps-deploy-key']) {
                    sh '''
                        set -eu
                        REMOTE="${DEPLOY_USER}@${DEPLOY_HOST}"
                        scp -P "$DEPLOY_PORT" -o BatchMode=yes -o StrictHostKeyChecking=yes \
                            compose.vps.yml "$REMOTE:$DEPLOY_DIR/compose.vps.yml"
                        scp -P "$DEPLOY_PORT" -o BatchMode=yes -o StrictHostKeyChecking=yes \
                            .env.vps "$REMOTE:$DEPLOY_DIR/.env"
                        ssh -p "$DEPLOY_PORT" -o BatchMode=yes -o StrictHostKeyChecking=yes "$REMOTE" \
                            "cd '$DEPLOY_DIR' && docker compose -f compose.vps.yml pull && docker compose -f compose.vps.yml up -d --remove-orphans && docker compose -f compose.vps.yml ps"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline VPS hoàn tất với tag ${env.VERSION_COMMIT}"
        }
        failure {
            echo " Pipeline thất bại! Vui lòng kiểm tra lại log chi tiết."
        }
    }
}
